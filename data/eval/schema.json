{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence RAG Phase 3 question",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "question",
    "type",
    "expected_answer",
    "evidence_spans",
    "target_version",
    "answerability",
    "requester",
    "acl_allowance",
    "lineage_key",
    "split",
    "author",
    "validated",
    "drafted_by",
    "paraphrased",
    "version_independent"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "type": {
      "enum": [
        "factoid",
        "exact_identifier",
        "table",
        "multi_hop",
        "version_specific",
        "unchanged_control",
        "version_unavailable",
        "unanswerable",
        "acl"
      ]
    },
    "expected_answer": {"type": "string"},
    "evidence_spans": {"type": "array", "items": {"type": "object"}},
    "target_version": {"type": "string", "minLength": 1},
    "answerability": {"type": "boolean"},
    "requester": {"type": "string", "minLength": 1},
    "acl_allowance": {"type": "boolean"},
    "lineage_key": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "dev", "test", "blind"]},
    "author": {"type": "string", "minLength": 1},
    "validated": {"type": "boolean"},
    "review_status": {"enum": ["accepted", "rejected"]},
    "drafted_by": {"type": "string", "minLength": 1},
    "paraphrased": {"type": "boolean"},
    "version_independent": {"type": "boolean"},
    "gold_versions": {"type": "array", "uniqueItems": true, "items": {"enum": ["pg-15", "pg-16", "pg-17"]}},
    "evidence_quote": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}
  },
  "allOf": [{
    "if": {"properties": {"author": {"const": "llm_drafted"}}},
    "then": {"properties": {"validated": {"const": false}, "split": {"enum": ["dev", "test"]}}}
  }, {
    "if": {"properties": {"version_independent": {"const": true}}},
    "then": {"required": ["gold_versions"], "properties": {"gold_versions": {"minItems": 1}}}
  }, {
    "if": {"required": ["review_status"], "properties": {"review_status": {"const": "rejected"}}},
    "then": {"properties": {"validated": {"const": false}}}
  }, {
    "if": {"required": ["review_status"], "properties": {"review_status": {"const": "accepted"}}},
    "then": {"properties": {"validated": {"const": true}}}
  }, {
    "if": {"properties": {"split": {"const": "blind"}}},
    "then": {"required": ["review_status"]}
  }]
}
