RAG_ENV=development
RAG_LOG_LEVEL=INFO
RAG_CHUNK_MAX_TOKENS=220
RAG_CHUNK_OVERLAP_TOKENS=35
RAG_RETRIEVAL_TOP_K=5
RAG_RETRIEVAL_CANDIDATE_K=30
RAG_HYBRID_ALPHA=0.55
RAG_MAX_CONTEXT_CHARS=18000
RAG_STORAGE_BACKEND=memory
RAG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evidence_rag
RAG_EMBEDDER_ID=hash-v1
RAG_EMBEDDING_BATCH_SIZE=64
RAG_MIGRATIONS_PATH=migrations
RAG_JOB_POLL_SECONDS=1.0
# Google AI Studio key is intentionally not committed. It is unused by the
# local baseline and should only be provided for a later, cached evaluation run.
# GEMINI_API_KEY=
