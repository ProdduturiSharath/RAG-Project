RAG_ENV=development
RAG_LOG_LEVEL=INFO
RAG_CHUNK_MAX_TOKENS=220
RAG_CHUNK_OVERLAP_TOKENS=35
RAG_RETRIEVAL_TOP_K=5
RAG_RETRIEVAL_CANDIDATE_K=30
RAG_HYBRID_ALPHA=0.55
RAG_DENSE_MODEL=hash-v1
RAG_METADATA_PREFIXED_EMBEDDINGS=false
RAG_FUSION_METHOD=rrf
RAG_RERANKER_MODEL=token-overlap
RAG_RERANK_TOP_N=30
RAG_VERSION_MODE=none
RAG_VERSION_SELECTOR=exact
RAG_PARENT_EXPANSION=true
RAG_MAX_CONTEXT_CHARS=18000
RAG_STORAGE_BACKEND=memory
POSTGRES_DB=evidence_rag_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RAG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evidence_rag_demo
# Keep the Phase 3 corpus out of the disposable test database.
RAG_EVAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evidence_rag_eval
RAG_EMBEDDER_ID=hash-v1
RAG_EMBEDDING_BATCH_SIZE=64
RAG_MIGRATIONS_PATH=migrations
RAG_JOB_POLL_SECONDS=1.0
# Offline extractive remains the default; opt in to verified DeepSeek serving.
RAG_GENERATION_BACKEND=extractive
RAG_EXTRACTIVE_MINIMUM_SCORE=0.0
# DEEPSEEK_API_KEY=
# HS256 only; use a randomly generated value of at least 32 bytes in deployment.
RAG_JWT_ALGORITHM=HS256
RAG_JWT_SECRET=replace-with-at-least-32-random-bytes
RAG_MAX_REQUEST_BODY_BYTES=262144
RAG_MAX_QUERY_CHARS=4096
RAG_MAX_DOCUMENT_CHARS=200000
RAG_MAX_SECTION_CHARS=50000
RAG_MAX_SECTIONS=100
RAG_MAX_METADATA_KEYS=50
RAG_MAX_METADATA_DEPTH=4
RAG_RATE_LIMIT_REQUESTS=60
RAG_RATE_LIMIT_WINDOW_SECONDS=60
RAG_REQUEST_TIMEOUT_SECONDS=30
RAG_DATABASE_CONNECT_TIMEOUT_SECONDS=5
RAG_DATABASE_STATEMENT_TIMEOUT_MS=30000
RAG_UI_API_URL=http://127.0.0.1:8000
RAG_DEMO_VOLUME=evidence_rag_demo_pgdata
